# ─────────────────────────────────────────────────────────
# Mihwar (محور) — environment variables
# Copy to .env and fill in. In Coolify, paste these into the
# "Environment Variables" panel for the application.
# ─────────────────────────────────────────────────────────

# PostgreSQL connection string. In Coolify, create a Postgres
# resource then click "Connect" → copy the internal URL.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://mihwar:CHANGE_ME@mihwar-db:5432/mihwar?schema=public"

# Auth.js (NextAuth v5) — REQUIRED.
# Generate with:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Public URL of the deployed app (no trailing slash).
# Coolify will give you this when the domain is bound.
AUTH_URL="https://mihwar.your-domain.com"

# Optional: Next.js origin for production
NEXT_PUBLIC_APP_URL="https://mihwar.your-domain.com"

# ─────────────────────────────────────────────────────────
# Initial admin (used by `pnpm db:seed`).
# ─────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@mihwar.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Mihwar@2026"
ADMIN_NAME="مدير الفريق"

# Set RUN_SEED=true on first deploy to auto-seed the database.
# Switch to false (or remove) after the first successful run.
RUN_SEED="true"

# Node env
NODE_ENV="production"
